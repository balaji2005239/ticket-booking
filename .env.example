# Flask
FLASK_ENV=development
SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-jwt-secret

# Database (PostgreSQL)
# Local example: postgresql://postgres:postgres@localhost:5432/ticketing
# Render/Railway will inject their own DATABASE_URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ticketing

# Seat hold / waitlist offer timing (seconds)
HOLD_TTL_SECONDS=600
OFFER_TTL_SECONDS=600
SCHEDULER_INTERVAL_SECONDS=30

# Email (SMTP) — free tier e.g. Brevo, SendGrid, or Gmail app password
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=noreply@yourticketapp.com
SMTP_FROM_NAME=Ticket Booking

# Frontend base URL — used to build the time-limited waitlist offer link
FRONTEND_BASE_URL=http://localhost:5500
