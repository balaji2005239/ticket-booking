# Flask
FLASK_ENV=development
SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-jwt-secret

# Database (PostgreSQL)
# Local example: postgresql://postgres:postgres@localhost:5432/ticketing
# Render/Railway will inject their own DATABASE_URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ticketing

# Seat hold / waitlist offer / email-OTP timing (seconds)
HOLD_TTL_SECONDS=600
OFFER_TTL_SECONDS=600
SCHEDULER_INTERVAL_SECONDS=30
OTP_TTL_SECONDS=600

# Email — Brevo's HTTP API (not SMTP; see app/utils/email.py's docstring —
# Render blocks outbound SMTP entirely, confirmed by testing). Get an API key
# from Brevo's dashboard: SMTP & API -> API Keys (NOT the SMTP tab — that's a
# different credential and won't work here).
BREVO_API_KEY=your-brevo-api-key
# MUST be an address you've verified as a sender in Brevo (Senders, Domains &
# Dedicated IPs -> Senders) — an unverified address (like this placeholder)
# gets silently rejected at delivery time: the API call itself still
# succeeds (send_email() returns True), only the actual send fails
# downstream, so this is easy to miss without checking Brevo's own
# Transactional -> Email Activity logs.
EMAIL_FROM_ADDRESS=your-verified-sender@example.com
EMAIL_FROM_NAME=Ticket Booking

# Frontend base URL — used to build the time-limited waitlist offer link
FRONTEND_BASE_URL=http://localhost:5500
